<?xml version="1.0" encoding="UTF-8"?>
<!--
launchd plist for the Orbit Photo Director generator daemon.

Install:
  cp ops/com.astroanil.orbit-photo-director.plist ~/Library/LaunchAgents/
  launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.astroanil.orbit-photo-director.plist
  launchctl enable gui/$UID/com.astroanil.orbit-photo-director

Stop / unload:
  launchctl bootout gui/$UID/com.astroanil.orbit-photo-director

Verify:
  launchctl print gui/$UID/com.astroanil.orbit-photo-director

EDIT BEFORE INSTALL:
  - Replace REPO_PATH below with the absolute path to your orbit-photo-director repo
    (e.g., /Users/astroanil/orbit-photo-director)
  - Confirm the Python interpreter path (use the venv's python: REPO_PATH/.venv/bin/python)

WatchPaths (added 2026-05-17, fixes 13-day stale-module bug):
  The daemon is a long-lived Python process that imports generator.* modules
  ONCE on startup, then loops forever. Without WatchPaths, file edits to
  generator/*.py on disk do not take effect until the process restarts.
  Adding WatchPaths makes launchd kill + restart the job whenever any
  watched file is modified — including via git pull, editor save, or
  branch checkout. Combined with KeepAlive.Crashed=true, restarts are
  automatic. ThrottleInterval=30 prevents thrashing if many files change
  in quick succession (e.g., a `git pull` touching 10 files restarts the
  daemon at most once per 30 s).

  Adding new generator/*.py files? Add a WatchPaths entry for them too —
  launchd does not watch recursively or auto-discover.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.astroanil.orbit-photo-director</string>

    <key>ProgramArguments</key>
    <array>
        <string>REPO_PATH/.venv/bin/python</string>
        <string>-m</string>
        <string>generator.daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPO_PATH</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OPD_ROOT</key>
        <string>REPO_PATH</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- V3-P2 ASCENT (enabled 2026-05-17 soak, kept on 2026-05-22).
             Off by default in generator/config.py; this flag turns on
             ASCENT predictions (rocket plume captures during launch
             climb phase). Produces PassEntry with launch.kind="ascent"
             plus per-launch trajectory polylines for the ascent map
             layer. Remove this entry to roll back to OVERHEAD-only. -->
        <key>OPD_ENABLE_ASCENT</key>
        <string>1</string>
        <!-- Weather v1.3 (enabled 2026-05-19). Off by default in
             generator/config.py; turns on NHC hurricane tracker +
             real lightning sampler (GLM observed + GFS CAPE forecast,
             v1.3.2). Remove this entry to roll back to weather-off. -->
        <key>OPD_ENABLE_WEATHER</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Restart the daemon when any generator module changes on disk.
         See the long comment at the top of this file for context. -->
    <key>WatchPaths</key>
    <array>
        <string>REPO_PATH/generator/__init__.py</string>
        <string>REPO_PATH/generator/ascent.py</string>
        <string>REPO_PATH/generator/ascent_profiles.py</string>
        <string>REPO_PATH/generator/cloud.py</string>
        <string>REPO_PATH/generator/config.py</string>
        <string>REPO_PATH/generator/daemon.py</string>
        <string>REPO_PATH/generator/launch_data.py</string>
        <string>REPO_PATH/generator/lightning.py</string>
        <string>REPO_PATH/generator/main.py</string>
        <string>REPO_PATH/generator/manifest.py</string>
        <string>REPO_PATH/generator/orbit.py</string>
        <string>REPO_PATH/generator/score.py</string>
    </array>

    <key>StandardOutPath</key>
    <string>REPO_PATH/data/logs/launchd.out</string>

    <key>StandardErrorPath</key>
    <string>REPO_PATH/data/logs/launchd.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
